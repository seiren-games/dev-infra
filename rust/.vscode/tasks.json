		},
		{
			"label": "rust: test + Windows build",
			"dependsOn": [
				"rust: cargo test",
				"rust: cargo build x86_64-pc-windows-gnu --release"
			],
			"dependsOrder": "sequence",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
