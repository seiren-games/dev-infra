	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"command": "nix develop --no-update-lock-file --command cargo test",
			"problemMatcher": [],
			"group": {
				"kind": "build"
			},
			"label": "rust: cargo test"
		},
		{
			"type": "shell",
			"command": "nix develop --no-update-lock-file --command cargo-build-windows --release --locked",
