# shellcheck shell=bash
# このファイルは https://github.com/seiren-games/dev-infra で管理されています。様々なリポジトリで共有することが目的のファイルです。

if ! has nix_direnv_disallow_fallback; then
  echo "nix-direnv is required to load the Rust development environment" >&2
  return 1
fi

watch_file .cargo/config.toml .cargo/config
nix_direnv_disallow_fallback

verify_cargo_configuration() {
  local key="$1"
  local expected="$2"
  local actual

  if ! actual="$(cargo -Zunstable-options config get "$key")" \
    || [[ "$actual" != "$expected" ]]; then
    echo "Cargo's dependency cooldown configuration is invalid: $key" >&2
    return 1
  fi
}

verify_rust_dev_environment() {
  local expected_cargo_commit
  local cargo_version

  if ! use flake . --no-update-lock-file; then
    echo "failed to load the locked Rust development environment" >&2
    return 1
  fi

  expected_cargo_commit="${DEV_INFRA_RUST_NIGHTLY_CARGO_COMMIT:-}"
  if [[ -z "$expected_cargo_commit" ]]; then
    echo "the default dev shell does not expose the pinned nightly Cargo" >&2
    return 1
  fi

  if ! cargo_version="$(cargo --version --verbose)" \
    || ! printf '%s\n' "$cargo_version" | grep -Fqx "commit-hash: $expected_cargo_commit"; then
    echo "the default dev shell does not expose the pinned nightly Cargo" >&2
    return 1
  fi

  verify_cargo_configuration \
    registry.global-min-publish-age \
    'registry.global-min-publish-age = "7 days"' \
    || return 1
  verify_cargo_configuration \
    unstable.min-publish-age \
    'unstable.min-publish-age = true' \
    || return 1

  if cargo -Zunstable-options config get resolver.incompatible-publish-age \
    > /dev/null 2>&1; then
    echo "resolver.incompatible-publish-age must use Cargo's default deny policy" >&2
    return 1
  fi

  if [[ -n "${CARGO_RESOLVER_INCOMPATIBLE_PUBLISH_AGE+x}" ]]; then
    echo "CARGO_RESOLVER_INCOMPATIBLE_PUBLISH_AGE must not override the default deny policy" >&2
    return 1
  fi

  if cargo -Zunstable-options config get registry.min-publish-age > /dev/null 2>&1; then
    echo "registry.min-publish-age must not override the global cooldown policy" >&2
    return 1
  fi

  if cargo -Zunstable-options config get registries 2> /dev/null \
    | grep -F ".min-publish-age" > /dev/null; then
    echo "registries.<name>.min-publish-age must not override the global cooldown policy" >&2
    return 1
  fi

  if env | grep -E '^CARGO_REGISTRIES_[[:alnum:]_]+_MIN_PUBLISH_AGE=' > /dev/null; then
    echo "CARGO_REGISTRIES_<name>_MIN_PUBLISH_AGE must not override the global cooldown policy" >&2
    return 1
  fi
}

# Validate in a subshell so a failed check cannot partially export the dev shell.
if ! (verify_rust_dev_environment); then
  unset -f verify_cargo_configuration verify_rust_dev_environment
  return 1
fi

unset -f verify_cargo_configuration verify_rust_dev_environment
if ! use flake . --no-update-lock-file; then
  echo "failed to load the locked Rust development environment" >&2
  return 1
fi
