#!/usr/bin/env bash
# このファイルは https://github.com/seiren-games/dev-infra で管理されています。様々なリポジトリで共有することが目的のファイルです。
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/secret-scan all
  scripts/secret-scan pre-commit
  scripts/secret-scan pre-push <remote-name>
EOF
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

config_path="$repo_root/.gitleaks.toml"
public_ok_schema_path="$repo_root/scripts/public-ok-review.schema.json"
zero_sha="0000000000000000000000000000000000000000"

default_public_ok_skill_path() {
  if [[ -n "${HOME:-}" ]]; then
    printf '%s\n' "$HOME/dotfiles/home/.agents/skills/review-public-ok/SKILL.md"
    return
  fi

  printf '%s\n' "dotfiles/home/.agents/skills/review-public-ok/SKILL.md"
}

public_ok_skill_path="${PUBLIC_OK_SKILL_PATH:-$(default_public_ok_skill_path)}"

gitleaks_cmd() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks "$@"
    return
  fi

  if command -v nix >/dev/null 2>&1; then
    nix develop --no-write-lock-file "path:$repo_root" --command gitleaks "$@"
    return
  fi

  echo "secret-scan: gitleaks is not installed and nix is unavailable" >&2
  exit 127
}

codex_cmd() {
  local codex_bin="${CODEX_BIN:-codex}"

  if ! command -v "$codex_bin" >/dev/null 2>&1; then
    echo "secret-scan: codex CLI is not installed or not on PATH" >&2
    return 127
  fi

  "$codex_bin" "$@"
}

prepare_codex_home() {
  local source_home="${CODEX_HOME:-}"
  if [[ -z "$source_home" && -n "${HOME:-}" ]]; then
    source_home="$HOME/.codex"
  fi

  local cache_dir temp_home
  if [[ -n "${XDG_CACHE_HOME:-}" ]]; then
    cache_dir="$XDG_CACHE_HOME/dev-infra-secret-scan"
  elif [[ -n "${HOME:-}" ]]; then
    cache_dir="$HOME/.cache/dev-infra-secret-scan"
  else
    cache_dir="${TMPDIR:-/tmp}/dev-infra-secret-scan"
  fi
  mkdir -p "$cache_dir"
  chmod 700 "$cache_dir"
  temp_home="$(mktemp -d "$cache_dir/codex-home.XXXXXX")"
  chmod 700 "$temp_home"

  local file source_path
  for file in auth.json config.toml; do
    source_path="$source_home/$file"
    if [[ -r "$source_path" ]]; then
      cp -p "$source_path" "$temp_home/$file"
      chmod u+rw,go-rwx "$temp_home/$file"
    fi
  done

  printf '%s\n' "$temp_home"
}

scan_git_log() {
  local log_opts="$1"

  gitleaks_cmd git \
    --config "$config_path" \
    --redact \
    --no-banner \
    --log-level warn \
    --log-opts "$log_opts" \
    "$repo_root"
}

review_public_ok() {
  if git diff --cached --quiet --exit-code; then
    return 0
  fi

  if [[ ! -f "$public_ok_skill_path" ]]; then
    echo "secret-scan: public review skill not found: $public_ok_skill_path" >&2
    exit 127
  fi

  if [[ ! -f "$public_ok_schema_path" ]]; then
    echo "secret-scan: public review schema not found: $public_ok_schema_path" >&2
    exit 127
  fi

  local review_output
  review_output="$(mktemp "${TMPDIR:-/tmp}/public-ok-review.XXXXXX.json")"
  local codex_home
  codex_home="$(prepare_codex_home)"

  echo "secret-scan: reviewing staged changes with codex" >&2
  # Codex transcripts may echo the staged diff, so only emit the sanitized final JSON.
  if ! CODEX_HOME="$codex_home" codex_cmd exec \
    --cd "$repo_root" \
    --sandbox read-only \
    --ephemeral \
    --output-schema "$public_ok_schema_path" \
    --output-last-message "$review_output" \
    --color never \
    - >/dev/null 2>&1 <<EOF
Use the following skill instructions to review the staged changes:

$(sed 's/^/> /' "$public_ok_skill_path")

You are running as a commit gate for a public repository.

Review only the staged changes. Use git diff --cached and do not evaluate unstaged,
untracked, or working-tree-only content. Decide whether the staged changes include
secrets, credentials, personal information, confidentiality markers, or any other
information that should not be committed to a public repository.

Return JSON matching the provided schema. Set public_ok to false if anything
potentially sensitive is present. Do not reproduce secret values verbatim in the
JSON; redact them and describe the risk.
EOF
  then
    echo "secret-scan: codex public review failed to run" >&2
    if [[ -s "$review_output" ]]; then
      sed 's/^/  /' "$review_output" >&2
    fi
    rm -f "$review_output"
    rm -rf "$codex_home"
    return 1
  fi

  if grep -Eq '"public_ok"[[:space:]]*:[[:space:]]*true' "$review_output"; then
    rm -f "$review_output"
    rm -rf "$codex_home"
    return 0
  fi

  echo "secret-scan: codex public review blocked this commit" >&2
  sed 's/^/  /' "$review_output" >&2
  rm -f "$review_output"
  rm -rf "$codex_home"
  return 1
}

case "${1:-}" in
  all)
    gitleaks_cmd git \
      --config "$config_path" \
      --redact \
      --no-banner \
      --log-level warn \
      "$repo_root"
    ;;

  pre-commit)
    gitleaks_cmd git \
      --pre-commit \
      --staged \
      --config "$config_path" \
      --redact \
      --no-banner \
      --log-level warn \
      "$repo_root"
    review_public_ok
    ;;

  pre-push)
    remote_name="${2:-}"
    if [[ -z "$remote_name" ]]; then
      usage
      exit 2
    fi

    blocked=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      if [[ -z "${local_ref:-}" || "$local_sha" == "$zero_sha" ]]; then
        continue
      fi

      if [[ "$remote_sha" == "$zero_sha" ]]; then
        log_opts="$local_sha --not --remotes=$remote_name"
      else
        log_opts="$remote_sha..$local_sha"
      fi

      echo "secret-scan: scanning $local_ref -> $remote_ref" >&2
      if ! scan_git_log "$log_opts"; then
        blocked=1
      fi
    done

    exit "$blocked"
    ;;

  *)
    usage
    exit 2
    ;;
esac
