#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/secret-scan all
  scripts/secret-scan pre-commit
  scripts/secret-scan pre-push <remote-name>
EOF
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

config_path="$repo_root/.gitleaks.toml"
zero_sha="0000000000000000000000000000000000000000"

gitleaks_cmd() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks "$@"
    return
  fi

  if command -v nix >/dev/null 2>&1; then
    nix develop "path:$repo_root" --command gitleaks "$@"
    return
  fi

  echo "secret-scan: gitleaks is not installed and nix is unavailable" >&2
  exit 127
}

scan_git_log() {
  local log_opts="$1"

  gitleaks_cmd git \
    --config "$config_path" \
    --redact \
    --no-banner \
    --log-level warn \
    --log-opts "$log_opts" \
    "$repo_root"
}

case "${1:-}" in
  all)
    gitleaks_cmd git \
      --config "$config_path" \
      --redact \
      --no-banner \
      --log-level warn \
      "$repo_root"
    ;;

  pre-commit)
    gitleaks_cmd git \
      --pre-commit \
      --staged \
      --config "$config_path" \
      --redact \
      --no-banner \
      --log-level warn \
      "$repo_root"
    ;;

  pre-push)
    remote_name="${2:-}"
    if [[ -z "$remote_name" ]]; then
      usage
      exit 2
    fi

    blocked=0
    while read -r local_ref local_sha remote_ref remote_sha; do
      if [[ -z "${local_ref:-}" || "$local_sha" == "$zero_sha" ]]; then
        continue
      fi

      if [[ "$remote_sha" == "$zero_sha" ]]; then
        log_opts="$local_sha --not --remotes=$remote_name"
      else
        log_opts="$remote_sha..$local_sha"
      fi

      echo "secret-scan: scanning $local_ref -> $remote_ref" >&2
      if ! scan_git_log "$log_opts"; then
        blocked=1
      fi
    done

    exit "$blocked"
    ;;

  *)
    usage
    exit 2
    ;;
esac
